# ============================================================================
# MIH — environment PRODUKSI (VPS). Salin ke `.env.prod` lalu isi nilai asli.
#   cp .env.example.prod .env.prod
# JANGAN commit `.env.prod` (sudah di .gitignore). File ini hanya template.
# ============================================================================

# --- PostgreSQL (dibaca compose untuk variabel interpolasi) -----------------
POSTGRES_USER=mih
# WAJIB diganti: `openssl rand -hex 32`
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mih

# --- OpenAI (VPS harus bisa keluar ke API OpenAI) ---------------------------
# WAJIB diisi nilai asli. JANGAN commit.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Backend -----------------------------------------------------------------
# WAJIB diganti: `openssl rand -hex 32`, minimal 32 karakter.
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars
# JWT_SECRET opsional — fallback ke SESSION_SECRET jika tidak diisi
JWT_SECRET=
PORT=3000

# --- Redis (opsional untuk sekarang, wajib di phase lanjutan) -----------------
REDIS_URL=redis://redis:6379

# --- Data & ingestion ----------------------------------------------------------
DATA_DIR=/data
INGEST_INTERVAL_SEC=30
VECTOR_K=8

# --- Google Drive sync (OPSIONAL; kosong = nonaktif) ---------------------------
# DRIVE_REMOTE=rclone remote + path folder, mis. gdrive:folder-rag
DRIVE_REMOTE=
# DRIVE_DEST=/data/raw/drive        # subdirektori tempat rclone sinkron (scope hapus hanya milik Drive)
DRIVE_DEST=/data/raw/drive
DRIVE_SYNC_INTERVAL_MIN=15
RCLONE_CONFIG=/data/rclone/rclone.conf

# --- SharePoint sync (OPSIONAL; kosong = nonaktif) -----------------------------
# Remote rclone (type onedrive) yang diarahkan ke document library SharePoint.
# SHAREPOINT_REMOTE=sp:<path-folder-dalam-library> (atau sp: untuk root library)
SHAREPOINT_REMOTE=
# SHAREPOINT_DEST=/data/raw/sharepoint  # subdirektori tempat rclone sinkron (scope hapus hanya milik SharePoint)
SHAREPOINT_DEST=/data/raw/sharepoint

# --- n8n RAG retrieval engine (OPSIONAL; kosong = pakai query lokal) ----------
# URL webhook n8n yang menggantikan search() lokal.
# Lihat docs/superpowers/specs/2026-08-27-n8n-rag-engine-design.md
N8N_RAG_WEBHOOK_URL=

# --- Seed admin (jalankan sekali, idempotent) ---------------------------------
#   docker compose --env-file .env.prod -f docker-compose.prod.yml run --rm seed
ADMIN_EMAIL=admin@kedeputian.go.id
ADMIN_PASSWORD=change-me-on-first-login

# --- Reverse proxy host (BUKAN dipakai compose) --------------------------------
# Dipakai di docs/DEPLOY-VPS.md + deploy/vps/nginx-mih.conf.example.
SERVER_NAME=mih.<domain>.go.id
LETSENCRYPT_EMAIL=admin@<domain>.go.id

# --- Proxy korporat (OPSIONAL) -------------------------------------------------
# KOSONG di VPS dengan internet langsung. Isi bila jaringan memblokir akses luar.
# Variabel ini diserap docker-compose.prod.yml via anchor x-proxy-env.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# --- Catatan CORS --------------------------------------------------------------
# Backend TIDAK butuh CORS_ORIGIN: frontend nginx (internal) me-proxy /api/ ke
# backend secara same-origin, dan reverse proxy host meneruskan semuanya ke
# 127.0.0.1:8080. Cookie session aman karena semua request satu origin.
