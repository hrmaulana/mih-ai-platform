# PostgreSQL
DATABASE_URL=postgres://mih:mih@db:5432/mih

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Backend
# WAJIB: string acak minimal 32 karakter (mis. output `openssl rand -hex 32`)
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars
PORT=3000

# Rate limit login: maks percobaan gagal per IP per jendela waktu
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Data & ingestion
DATA_DIR=/data
INGEST_INTERVAL_SEC=30
VECTOR_K=8

# --- Google Drive sync (OPSIONAL; kosong = nonaktif) ---------------------------
# DRIVE_REMOTE=rclone remote + path folder, mis. gdrive:folder-rag
DRIVE_REMOTE=
# DRIVE_DEST=/data/raw/drive        # subdirektori tempat rclone sinkron (scope hapus hanya milik Drive)
DRIVE_DEST=/data/raw/drive
DRIVE_SYNC_INTERVAL_MIN=15
RCLONE_CONFIG=/data/rclone/rclone.conf

# --- SharePoint sync (OPSIONAL; kosong = nonaktif) -----------------------------
# Remote rclone (type onedrive) yang diarahkan ke document library SharePoint.
# Buat via `rclone config` -> pilih "OneDrive" -> pilih library SharePoint saat prompt drive.
# SHAREPOINT_REMOTE=sp:<path-folder-dalam-library> (atau sp: untuk root library)
SHAREPOINT_REMOTE=
# SHAREPOINT_DEST=/data/raw/sharepoint  # subdirektori tempat rclone sinkron (scope hapus hanya milik SharePoint)
SHAREPOINT_DEST=/data/raw/sharepoint

# --- n8n RAG retrieval engine (OPSIONAL; kosong = pakai query lokal) ----------
# URL webhook n8n yang menggantikan search() lokal.
# Lihat docs/superpowers/specs/2026-08-27-n8n-rag-engine-design.md
N8N_RAG_WEBHOOK_URL=

# Seed admin (jalankan sekali)
ADMIN_EMAIL=admin@kedeputian.go.id
ADMIN_PASSWORD=change-me-on-first-login
